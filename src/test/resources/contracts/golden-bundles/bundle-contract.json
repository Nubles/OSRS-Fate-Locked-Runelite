  "rules.unlocks.guilds": "array",
  "rules.unlocks.guilds[]": "string",
  "rules.unlocks.farming": "array",
  "rules.unlocks.farming[]": "string",
  "rules.unlocks.slayer": "array",
  "rules.unlocks.slayer[]": "string",
  "rules.unlocks.quests": "array",
  "rules.unlocks.quests[]": "string",
  "rules.itemRules": "object",
  "rules.itemRules.*": "object",
  "rules.itemRules.*.tier": "integer",
  "rules.itemRules.*.slot": "string",
  "rules.chunks": "object",
  "rules.chunks.*": "object",
  "rules.chunks.*.chunkKey": "string",
  "rules.chunks.*.name": "string|null",
  "rules.chunks.*.region": "string|null",
  "rules.chunks.*.entry": "status",
  "rules.chunks.*.categories": "object",
  "rules.chunks.*.categories.*": "array",
  "rules.chunks.*.categories.*[]": "object",
  "rules.chunks.*.categories.*[].key": "string",
  "rules.chunks.*.categories.*[].name": "string",
  "rules.chunks.*.categories.*[].status": "status",
  "rules.chunks.*.categories.*[].detail": "string",
  "rules.chunks.*.categories.*[].targetKind": "string",
  "rules.chunks.*.counts": "object",
  "rules.chunks.*.counts.allowed": "integer",
  "rules.chunks.*.counts.notReady": "integer",
  "rules.chunks.*.counts.locked": "integer",
  "rules.chunks.*.counts.unknown": "integer"
 },
 "required": {
  "about": "The installed builds refuse a version 4 bundle unless each of these is present, and not blank or empty.",
  "paths": [
   "chunks",
   "rules",
   "rules.rulesVersion",
   "rules.runId",
   "rules.gameModeId",
   "rules.exportedAt",
   "rules.unlocks",
   "rules.chunks"
  ]
 },
 "always": {
  "about": "Every bundle the relay path builds has these, wherever their parent is. Readers fall back when one is missing, and the fallback changes what they show: without freeAreas, the installed builds treat all of Misthalin as free.",
  "paths": [
   "version",
   "chunkOffset",
   "chunkOffset.cx",
   "chunkOffset.cy",
   "chunks",
   "chunks.*[].cx",
   "chunks.*[].cy",
   "subAreaChunks",
   "subAreaChunks.*[].cx",
   "subAreaChunks.*[].cy",
   "regionGroups",
   "unlockedRegions",
   "freeAreas",
   "chunkContent",
   "itemTiers",
   "slayerChunks",
   "slayerChunks.*[].cx",
   "slayerChunks.*[].cy",
   "state",
   "state.keys",
   "state.specialKeys",
   "state.chaosKeys",
   "state.fatePoints",
   "state.activeBuff",
   "state.pinnedGoals",
   "state.equipment",
   "rules",
   "rules.rulesVersion",
   "rules.contentVersion",
   "rules.detectorContractVersion",
   "rules.runId",
   "rules.runRevision",
   "rules.account",
   "rules.gameModeId",
   "rules.exportedAt",
   "rules.bankLocks",
   "rules.knownMobility",
   "rules.unlocks",
   "rules.unlocks.regions",
   "rules.unlocks.chunks",
   "rules.unlocks.equipment",
   "rules.unlocks.banks",
   "rules.unlocks.mobility",
   "rules.itemRules",
   "rules.itemRules.*.tier",
   "rules.itemRules.*.slot",
   "rules.chunks",
   "rules.chunks.*.name",
   "rules.chunks.*.region",
   "rules.chunks.*.entry",
   "rules.chunks.*.categories",
   "rules.chunks.*.categories.*[].name",
   "rules.chunks.*.categories.*[].status"
  ]
 },
 "presentWhen": {
  "about": "Present in exactly these runs. A root unlockedChunks marks a Chunked run for the installed builds and the overlay. state.linkedAccount is the bound account that 874b9d1's HUD and wrong-account warning read.",
  "fields": {
   "unlockedChunks": { "path": "rules.gameModeId", "equals": "chunked" },
   "state.linkedAccount": { "path": "rules.account", "notEquals": null }
  }
 },
 "overlay": {
  "about": "The fields the stream overlay reads.",
  "paths": [
   "unlockedRegions",
   "unlockedChunks",
   "state.keys",
   "state.specialKeys",
   "state.chaosKeys",
   "state.fatePoints",
   "state.activeBuff",
   "state.pinnedGoals"
  ]
 },
 "unread": {
  "about": "Parsed by the installed builds but never read from a version 4 bundle, and not read by the overlay. Root copies give way to rules, and a snapshot's chunkKey is restored from its map key. The export may leave these out; while present, they keep their types.",
  "paths": [
   "runId",
   "runRevision",
   "rulesVersion",
   "contentVersion",
   "detectorContractVersion",
   "bankLocks",
   "unlockedBanks",
   "rules.unlocks.skills",
   "rules.unlocks.levels",
   "rules.unlocks.merchants",
   "rules.unlocks.bosses",
   "rules.unlocks.minigames",
   "rules.unlocks.arcana",
   "rules.unlocks.guilds",
   "rules.unlocks.farming",
   "rules.unlocks.slayer",
   "rules.unlocks.quests",
   "rules.chunks.*.chunkKey",
   "rules.chunks.*.counts",
   "rules.chunks.*.categories.*[].key"
  ]
 }
