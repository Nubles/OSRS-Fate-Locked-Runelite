  "state.specialKeys": "integer",
  "state.chaosKeys": "integer",
  "state.fatePoints": "integer",
  "state.activeBuff": "string",
  "state.pinnedGoals": "array",
  "state.pinnedGoals[]": "string",
  "state.linkedAccount": "string",
  "state.equipment": "object",
  "state.equipment.*": "integer",
  "rules": "object",
  "rules.rulesVersion": "string",
  "rules.contentVersion": "integer",
  "rules.detectorContractVersion": "integer",
  "rules.runId": "string",
  "rules.runRevision": "integer",
  "rules.account": "string|null",
  "rules.gameModeId": "string",
  "rules.exportedAt": "string",
  "rules.bankLocks": "boolean",
  "rules.knownMobility": "array",
  "rules.knownMobility[]": "string",
  "rules.unlocks": "object",
  "rules.unlocks.regions": "array",
  "rules.unlocks.regions[]": "string",
  "rules.unlocks.chunks": "array",
  "rules.unlocks.chunks[]": "string",
  "rules.unlocks.skills": "object",
  "rules.unlocks.skills.*": "integer",
  "rules.unlocks.levels": "object",
