  "runId": "string",
  "runRevision": "integer",
  "rulesVersion": "string",
  "contentVersion": "integer",
  "detectorContractVersion": "integer",
  "chunkOffset": "object",
  "chunkOffset.cx": "integer",
  "chunkOffset.cy": "integer",
  "chunks": "object",
  "chunks.*": "array",
  "chunks.*[]": "object",
  "chunks.*[].cx": "integer",
  "chunks.*[].cy": "integer",
  "subAreaChunks": "object",
  "subAreaChunks.*": "array",
  "subAreaChunks.*[]": "object",
  "subAreaChunks.*[].cx": "integer",
  "subAreaChunks.*[].cy": "integer",
  "regionGroups": "object",
  "regionGroups.*": "array",
  "regionGroups.*[]": "string",
  "unlockedRegions": "array",
  "unlockedRegions[]": "string",
  "freeAreas": "array",
  "freeAreas[]": "string",
  "unlockedChunks": "array",
  "unlockedChunks[]": "string",
  "bankLocks": "boolean",
  "unlockedBanks": "array",
  "unlockedBanks[]": "string",
  "chunkContent": "object",
  "chunkContent.*": "object",
  "chunkContent.*.*": "array",
  "chunkContent.*.*[]": "string",
  "itemTiers": "object",
  "itemTiers.*": "integer",
  "slayerChunks": "object",
  "slayerChunks.*": "array",
  "slayerChunks.*[]": "object",
  "slayerChunks.*[].cx": "integer",
  "slayerChunks.*[].cy": "integer",
  "state": "object",
