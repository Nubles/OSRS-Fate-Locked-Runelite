  "rules.unlocks.equipment": "object",
  "rules.unlocks.equipment.*": "integer",
  "rules.unlocks.banks": "array",
  "rules.unlocks.banks[]": "string",
  "rules.unlocks.merchants": "array",
  "rules.unlocks.merchants[]": "string",
  "rules.unlocks.bosses": "array",
  "rules.unlocks.bosses[]": "string",
  "rules.unlocks.minigames": "array",
  "rules.unlocks.minigames[]": "string",
  "rules.unlocks.mobility": "array",
  "rules.unlocks.mobility[]": "string",
  "rules.unlocks.arcana": "array",
