{
 "schema": 1,
 "about": "What a version 4 bundle promises the readers already in players' hands: the RuneLite plugin builds installed from the Plugin Hub, and the stream overlay the relay feeds. The export never drops a field listed here unless it is unread, never changes a field's JSON type or meaning, and only ever adds fields. scripts/goldenBundles.test.ts checks every golden run against this file, and the plugin copies it at a pinned commit.",
 "version": 4,
 "installedBuilds": {
  "874b9d1": "Stage 0, the first Plugin Hub release",
  "4e37895": "Stage 1, on the Plugin Hub since 26 September 2026"
 },
 "readers": {
  "plugin": "The installed builds read the bundle with Gson into fixed classes. A value of another JSON type makes them refuse the whole bundle, and a status they don't know reads as UNKNOWN.",
  "overlay": "components/StreamOverlay.tsx reads the run state and the unlocked areas or chunks. A value of another type blanks it."
 },
 "paths": "Dotted from the root: \"*\" is every value of an object and \"[]\" every item of an array. A status is a string from statuses.",
 "statuses": ["ALLOWED", "NOT_READY", "LOCKED", "UNKNOWN"],
 "categories": {
  "about": "The only rule categories the installed builds' sidebar shows; a row in any other category is invisible to them.",
  "names": ["SKILLING", "BANKS", "SHOPS", "QUESTS", "COMBAT", "TRAVEL", "FARMING", "ACTIVITIES"]
 },
 "bankRows": {
  "about": "The installed builds find a chunk's bank by the row's target kind, so a row has this kind exactly when it is in this category.",
  "category": "BANKS",
  "targetKind": "BANK"
 },
 "fields": {
